<% internal_deployment = InternalDeployment.enabled? %>
<% support_email = ENV.fetch("REPLY_TO_EMAIL", "support@datapulsetech.ai") %>
<% content_for :email_preheader, internal_deployment ? "Your Lanthos Ops password changed." : t("mailers.devise.password_change.preheader") %>
<% content_for :email_eyebrow, internal_deployment ? "Account security" : t("mailers.devise.password_change.eyebrow") %>
<% content_for :email_title, internal_deployment ? "Password changed" : t("mailers.devise.password_change.title") %>
<% content_for :email_subtitle do %>
  <%= internal_deployment ? "A security change was made to your internal workspace account." : t("mailers.devise.password_change.subtitle") %>
<% end %>

<p><%= internal_deployment ? "Hello #{@resource.first_name}," : t("mailers.devise.password_change.greeting_html", name: @resource.first_name) %></p>

<div class="email-panel email-panel-success">
  <p class="email-panel-title"><%= internal_deployment ? "Change confirmed" : t("mailers.devise.password_change.success_title") %></p>
  <p style="margin-bottom: 0;"><%= internal_deployment ? "Your Lanthos Ops password was changed successfully." : t("mailers.devise.password_change.success_body") %></p>
</div>

<div class="email-panel email-panel-warning">
  <p class="email-panel-title"><%= internal_deployment ? "Wasn't you?" : t("mailers.devise.password_change.warning_title") %></p>
  <p style="margin-bottom: 0;"><%= internal_deployment ? "Contact #{support_email} immediately if you did not make this change." : t("mailers.devise.password_change.warning_body_html", email: "hello@saeloun.com") %></p>
</div>

<p><%= internal_deployment ? "Lanthos Ops" : t("mailers.devise.shared.signature_html") %></p>
