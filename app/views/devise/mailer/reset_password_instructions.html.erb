<% internal_deployment = InternalDeployment.enabled? %>
<% content_for :email_preheader, internal_deployment ? "Reset your Lanthos Ops password." : t("mailers.devise.reset_password.preheader") %>
<% content_for :email_eyebrow, internal_deployment ? "Account security" : t("mailers.devise.reset_password.eyebrow") %>
<% content_for :email_title, internal_deployment ? "Reset your password" : t("mailers.devise.reset_password.title") %>
<% content_for :email_subtitle do %>
  <%= internal_deployment ? "Securely choose a new password for your internal workspace." : t("mailers.devise.reset_password.subtitle") %>
<% end %>

<p><%= internal_deployment ? "Hello #{@resource.first_name}," : t("mailers.devise.reset_password.greeting") %></p>

<p><%= internal_deployment ? "A Lanthos Ops password reset was requested for #{@resource.email}." : t("mailers.devise.reset_password.request_html", email: @resource.email) %></p>

<p><%= internal_deployment ? "Use the button below to continue." : t("mailers.devise.reset_password.cta_body") %></p>

<%= render "shared/mailer/button", href: edit_password_url(@resource, reset_password_token: @token), label: internal_deployment ? "Reset password" : t("mailers.devise.reset_password.cta") %>

<div class="email-divider"></div>

<p class="email-muted"><%= internal_deployment ? "If you did not request this, ignore this email and your password will stay unchanged." : t("mailers.devise.reset_password.footer_note") %></p>
