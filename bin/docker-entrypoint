#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the Rails server then create or migrate the existing database.
verify_internal_deployment=false
if [[ "${*}" == *"falcon host"* ]] || [[ "${*}" == *"falcon serve"* ]] || [[ "${*}" == *"puma"* ]] || [[ "${*}" == *"bin/rails server"* ]]; then
  ./bin/rails db:prepare
  verify_internal_deployment=true
fi

# Workers must fail closed too; they can otherwise process queued access or
# billing work while the web service is refusing an unsafe cutover.
if [[ "${*}" == *"solid_queue:start"* ]]; then
  verify_internal_deployment=true
fi

if [[ "${verify_internal_deployment}" == "true" ]]; then
  # Rails owns flag parsing and the optional one-time owner bootstrap. Keeping
  # this unconditional prevents shell and application Boolean semantics from
  # drifting apart.
  bundle exec rake internal_deployment:startup
fi

exec "${@}"
